{
  "name": "micro-prolog",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "url": "git+https://github.com/ProgMiner/micro-prolog.git"
  },
  "scripts": {
    "start": "webpack serve --mode=development -d eval-source-map",
    "parser": "shx mkdir -p src/__generated__/editor && lezer-generator src/editor/parser.grammar --typeScript --names --export genParser -o src/__generated__/editor/parser.ts",
    "build": "shx mkdir -p ./build && shx cp -r ./public/* ./build && webpack --mode=production",
    "clean": "shx rm -rf ./build",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d ./build"
  },
  "license": "MIT",
  "dependencies": {
    "codemirror": "^6.0.2",
    "immutable": "^5.1.2"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "gh-pages": "^5.0.0",
    "shx": "^0.3.4",
    "ts-loader": "^9.4.3",
    "typescript": "^5.0.4",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1",
    "webpack-dev-server": "^5.2.1"
  }
}
